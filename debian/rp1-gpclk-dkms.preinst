#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

preflight=$(
# RP1_INCOMING_PREFLIGHT
)
printf '%s\n' "$preflight"
case "$preflight" in
*'"transition": "replace"'*)
    current=$(python3 -I /usr/libexec/rp1-gpclk-dkms/version_identity.py version)
    if [ -n "$(dkms status -m rp1-gpclk-dkms -v "$current")" ]; then
        dkms remove -m rp1-gpclk-dkms -v "$current" --all
    fi
    python3 -I /usr/libexec/rp1-gpclk-dkms/package_indices.py remove
    ;;
esac

#DEBHELPER#
exit 0
