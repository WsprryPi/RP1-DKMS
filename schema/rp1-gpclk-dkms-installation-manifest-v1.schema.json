{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "RP1 GPCLK installation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "administrationProtocol",
    "debianVersion",
    "dkmsModule",
    "installationBehavior",
    "kernelModule",
    "package",
    "packageInventory",
    "packageInventorySha256",
    "productVersion",
    "releaseChannel",
    "releaseTag",
    "repository",
    "schema",
    "schemaVersion",
    "sourceCommit",
    "uapi"
  ],
  "properties": {
    "schema": {
      "const": "rp1-gpclk-dkms-installation-manifest-v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "const": "WsprryPi/RP1-GPIO-CLK-DKMS"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 48
    },
    "debianVersion": {
      "type": "string",
      "pattern": "^[0-9][0-9A-Za-z.+~\\-]*-[1-9][0-9]*$",
      "maxLength": 128
    },
    "dkmsModule": {
      "const": "rp1-gpclk-dkms"
    },
    "kernelModule": {
      "const": "rp1_gpclk_dkms"
    },
    "administrationProtocol": {
      "const": "rp1-gpclk-route-manager"
    },
    "releaseChannel": {
      "const": "release"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 49
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packageInventorySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uapi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^usr/src/rp1-gpclk-dkms-[0-9A-Za-z.+\\-]+/include/uapi/linux/rp1_gpclk\\.h$",
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "filename",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "rp1-gpclk-dkms"
        },
        "filename": {
          "type": "string",
          "pattern": "^rp1-gpclk-dkms_[0-9][0-9A-Za-z.+~\\-]*_all\\.deb$",
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "installationBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeNeutral",
        "outputDisabled",
        "loadsModule",
        "appliesOverlay",
        "editsBootConfiguration",
        "operatesServices"
      ],
      "properties": {
        "routeNeutral": {
          "const": true
        },
        "outputDisabled": {
          "const": true
        },
        "loadsModule": {
          "const": false
        },
        "appliesOverlay": {
          "const": false
        },
        "editsBootConfiguration": {
          "const": false
        },
        "operatesServices": {
          "const": false
        }
      }
    },
    "packageInventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "path",
          "sha256",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_.+@/-]+$"
          },
          "type": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
